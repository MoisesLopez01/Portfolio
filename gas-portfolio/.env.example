# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the Netlify deployment.
# Set these in Netlify → Site settings → Environment variables (NOT in the repo).
# For local testing with `netlify dev`, copy this file to `.env` (which is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Donna / deal-risk LLM (Groq — https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# PlanetScale database (Dashboard → your DB → Connect → "@planetscale/database")
# Your MySQL Workbench connects to the SAME host/username/password.
DATABASE_HOST=aws.connect.psdb.cloud
DATABASE_USERNAME=xxxxxxxxxxxx
DATABASE_PASSWORD=pscale_pw_xxxxxxxxxxxx

# Lead-capture email (Resend — https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Donna <donna@yourdomain.com>
NOTIFY_EMAIL=moisesalex.01@gmail.com

# Admin panel password/token (any long random string you choose)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional hardening
# ALLOWED_ORIGIN=https://your-site.netlify.app
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_S=60
